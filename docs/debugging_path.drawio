<mxfile host="app.diagrams.net"><diagram id="debug" name="Debugging path"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="How we traced the low accuracy to the dataset" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="30" as="geometry"/></mxCell>
<mxCell id="obs" value="&lt;b&gt;Observation&lt;/b&gt;&lt;br&gt;Accuracy only ~70%,&lt;br&gt;model overfits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="125" width="150" height="120" as="geometry"/></mxCell>
<mxCell id="c1" value="1 Model too small?" style="swimlane;startSize=30;fillColor=#F3F7FE;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;html=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="200" y="60" width="180" height="250" as="geometry"/></mxCell>
<mxCell id="t1" value="&lt;b&gt;Deeper classifier&lt;/b&gt;&lt;br&gt;&lt;small&gt;more MLP layers&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="c1"><mxGeometry x="15" y="45" width="150" height="80" as="geometry"/></mxCell>
<mxCell id="r1" value="&lt;b&gt;Barely better&lt;/b&gt;&lt;br&gt;&lt;small&gt;still overfits&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="c1"><mxGeometry x="15" y="155" width="150" height="80" as="geometry"/></mxCell>
<mxCell id="c2" value="2 Training tricks?" style="swimlane;startSize=30;fillColor=#F3F7FE;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;html=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="410" y="60" width="180" height="250" as="geometry"/></mxCell>
<mxCell id="t2" value="&lt;b&gt;Regularisation&lt;/b&gt;&lt;br&gt;&lt;small&gt;dropout, early stopping&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="c2"><mxGeometry x="15" y="45" width="150" height="80" as="geometry"/></mxCell>
<mxCell id="r2" value="&lt;b&gt;Small gain&lt;/b&gt;&lt;br&gt;&lt;small&gt;only a few %&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="c2"><mxGeometry x="15" y="155" width="150" height="80" as="geometry"/></mxCell>
<mxCell id="c3" value="3 Is 70% plausible?" style="swimlane;startSize=30;fillColor=#F3F7FE;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;html=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="620" y="60" width="180" height="250" as="geometry"/></mxCell>
<mxCell id="t3" value="&lt;b&gt;Earlier balanced set&lt;/b&gt;&lt;br&gt;&lt;small&gt;~1,600 seqs, random functional proteins, no MMseqs2 split&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="c3"><mxGeometry x="15" y="45" width="150" height="80" as="geometry"/></mxCell>
<mxCell id="r3" value="&lt;b&gt;~80–85% there&lt;/b&gt;&lt;br&gt;&lt;small&gt;inflated by leakage, but 70% looks too low&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="c3"><mxGeometry x="15" y="155" width="150" height="80" as="geometry"/></mxCell>
<mxCell id="c4" value="4 Dataset defect?" style="swimlane;startSize=30;fillColor=#F3F7FE;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;html=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="830" y="60" width="180" height="250" as="geometry"/></mxCell>
